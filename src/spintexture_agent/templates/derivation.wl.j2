{% endif %}

(* Symbol declarations *)
ClearAll[x, y, z, t, A, K, Dmi, chi, alpha, s, tauDL, tauFL, px, py, pz];
coords2D = {x, y};
coords3D = {x, y, z};
{% if physics_ir and "anisotropic_dmi" in physics_ir.energy_terms %}
dmiType = "anisotropic_dmi";
{% elif physics_ir and "bulk_dmi" in physics_ir.energy_terms %}
dmiType = "bulk_dmi";
{% elif physics_ir and "interfacial_dmi" in physics_ir.energy_terms %}
dmiType = "interfacial_dmi";
{% elif physics_ir and "dmi_unspecified" in physics_ir.energy_terms %}
dmiType = "unspecified";
{% else %}
dmiType = "none";
{% endif %}

BuildDMIDensity[field_List] := Switch[dmiType,
  "interfacial_dmi", InterfacialDMIDensity[field, coords2D, Dmi, 3],
  "bulk_dmi", BulkDMIDensity[field, coords3D, Dmi],
  "anisotropic_dmi", AnisotropicDMIDensity[field, coords2D, Dmi, 3],
  _, 0
];

ExpectedDMIVariation[field_List] := Switch[dmiType,
  "interfacial_dmi",
    2 Dmi {-D[field[[3]], x], -D[field[[3]], y], D[field[[1]], x] + D[field[[2]], y]},
  "bulk_dmi", 2 Dmi Curl[field, coords3D],
  "anisotropic_dmi",
    2 Dmi {-D[field[[3]], x], D[field[[3]], y], D[field[[1]], x] - D[field[[2]], y]},
  _, Missing["NotApplicable"]
];

CheckDMIVariation[field_List] := If[
  MemberQ[{"interfacial_dmi", "bulk_dmi", "anisotropic_dmi"}, dmiType],
  TrueQ[
    FullSimplify[
      EulerLagrangeVector[BuildDMIDensity[field], field, coords2D]
      - ExpectedDMIVariation[field]
    ] === {0, 0, 0}
  ],
  Missing["NotApplicable"]
];
{% set topology_only = physics_ir and physics_ir.dynamics.expected_equation_type == "topology_only" %}

{% if task.material == "collinear_antiferromagnet" %}
(* Collinear AFM sigma-model field n = {nx, ny, nz}. *)
ClearAll[nx, ny, nz];
nVec = {nx[x, y, t], ny[x, y, t], nz[x, y, t]};

dmiDensity = BuildDMIDensity[nVec];
energyDensity = ExchangeDensity[nVec, coords2D, A] +
  EasyAxisDensity[nVec, K, 3] + dmiDensity;
dmiVariationalRegression = CheckDMIVariation[nVec];

Print["Energy density:"];
Print[energyDensity];
Print["Selected DMI density type:"];
Print[AgentRecord["dmi_density_type", dmiType]];
Print["DMI variational regression:"];
Print[AgentRecord["dmi_variational_regression", dmiVariationalRegression]];

varDeriv = TimeConstrained[
  EulerLagrangeVector[energyDensity, nVec, coords2D],
  20,
  "time_constrained_variational_derivative"
];
Print["Variational derivative delta U / delta n:"];
Print[varDeriv];

drive = SOTDrive[nVec, {px, py, pz}, tauDL, tauFL];
afmeq = TimeConstrained[
  AFMSigmaEquation[nVec, energyDensity, coords2D, t, chi, alpha, s, drive],
  20,
  "time_constrained_afm_sigma_equation"
];
Print["Projected AFM sigma-model equation:"];
Print[afmeq];

	{% if task.texture == "stripe_domain" %}
	(* Stripe-domain collective-coordinate calculation. *)
	ClearAll[
	  X, Phi, Xc, Phic, Delta, wallPolarity, k, Ueff,
	  u1, u2, u3, u4, Phi1, Phi2, Phi3, Phi4,
	  aLit, gammaLit, G2Lit, FXLit, FPhiLit
	];
	nDWDynamic = DomainWallAnsatz[x, t, X, Phi, Delta, 1];
	thetaDW = 2 ArcTan[Exp[(x - Xc)/Delta]];
	nDW = FullSimplify[
	  {Sin[thetaDW] Cos[Phic], Sin[thetaDW] Sin[Phic], Cos[thetaDW]},
	  Delta > 0
	];
	qVars = {Xc, Phic};
	dwAssumptions = Delta > 0 && Element[{Xc, Phic, chi, alpha, s}, Reals];
	metricIntegrand = FullSimplify[
	  Table[D[nDW, qVars[[i]]] . D[nDW, qVars[[j]]], {i, Length[qVars]}, {j, Length[qVars]}],
	  dwAssumptions
	];
	boundaryAssumptions = dwAssumptions && wallPolarity^2 == 1 &&
	  Element[{wallPolarity, px, py, pz, tauDL, tauFL}, Reals];
	nDWBoundary = {nDW[[1]], nDW[[2]], wallPolarity nDW[[3]]};
	boundaryTangents = Table[D[nDWBoundary, qVars[[i]]], {i, Length[qVars]}];
	sotProjectionIntegrand = FullSimplify[
	  Table[
	    SOTDrive[nDWBoundary, {px, py, pz}, tauDL, tauFL] . boundaryTangents[[i]],
	    {i, Length[qVars]}
	  ],
	  boundaryAssumptions
	];
	metricBoundaryRegression = TrueQ[
	  Join[
	    Flatten[FullSimplify[
	      Limit[metricIntegrand, x -> Infinity, Assumptions -> boundaryAssumptions],
	      boundaryAssumptions
	    ]],
	    Flatten[FullSimplify[
	      Limit[metricIntegrand, x -> -Infinity, Assumptions -> boundaryAssumptions],
	      boundaryAssumptions
	    ]]
	  ] === ConstantArray[0, 8]
	];
	sotBoundaryRegression = TrueQ[
	  Join[
	    FullSimplify[
	      Limit[sotProjectionIntegrand, x -> Infinity, Assumptions -> boundaryAssumptions],
	      boundaryAssumptions
	    ],
	    FullSimplify[
	      Limit[sotProjectionIntegrand, x -> -Infinity, Assumptions -> boundaryAssumptions],
	      boundaryAssumptions
	    ]
	  ] === ConstantArray[0, 4]
	];
	massMatrixDefinition = HoldForm[
	  CollectiveMassMatrix[nDW, qVars, {% raw %}{{x, -Infinity, Infinity}}{% endraw %}, chi, dwAssumptions]
	];
	dampingMatrixDefinition = HoldForm[
	  CollectiveDampingMatrix[nDW, qVars, {% raw %}{{x, -Infinity, Infinity}}{% endraw %}, alpha, s, dwAssumptions]
	];
	collectiveMetricMatrix = CollectiveMetricMatrix[
	  nDW, qVars, {% raw %}{{x, -Infinity, Infinity}}{% endraw %}, dwAssumptions
	];
	massMatrix = FullSimplify[chi collectiveMetricMatrix, dwAssumptions];
	dampingMatrix = FullSimplify[alpha s collectiveMetricMatrix, dwAssumptions];
	expectedMetricMatrix = {% raw %}{{2/Delta, 0}, {0, 2 Delta}}{% endraw %};
	ansatzConstraintRegression = TrueQ[FullSimplify[nDW . nDW, dwAssumptions] === 1];
	metricMatrixRegression = TrueQ[
	  FullSimplify[collectiveMetricMatrix - expectedMetricMatrix, dwAssumptions]
	  === ConstantArray[0, {2, 2}]
	];
	massMatrixRegression = TrueQ[
	  FullSimplify[massMatrix - chi expectedMetricMatrix, dwAssumptions]
	  === ConstantArray[0, {2, 2}]
	];
	dampingMatrixRegression = TrueQ[
	  FullSimplify[dampingMatrix - alpha s expectedMetricMatrix, dwAssumptions]
	  === ConstantArray[0, {2, 2}]
	];

	singleWallSOTForce = DomainWallSOTGeneralizedForce[
	  Phic, Delta, wallPolarity, {px, py, pz}, tauDL, tauFL
	];
	expectedSingleWallSOTForce = {
	  wallPolarity (-2 pz tauDL + Pi py tauFL Cos[Phic] - Pi px tauFL Sin[Phic]),
	  Delta (-2 pz tauFL - Pi py tauDL Cos[Phic] + Pi px tauDL Sin[Phic])
	};
	sotForceRegression = TrueQ[
	  FullSimplify[
	    singleWallSOTForce - expectedSingleWallSOTForce,
	    Delta > 0 && wallPolarity^2 == 1
	  ] === {0, 0}
	];

	(* Tveten et al. PRL 110, 127208 (2013), Eqs. (5) and (6a).
	   Build the source equation from independent coefficients and the explicit
	   wall metric before applying the declared coefficient/force bridge. *)
	literatureWallMetricTensor = {% raw %}{{2/Delta, 0}, {0, 2 Delta}}{% endraw %};
	literatureWallMassTensor = FullSimplify[
	  literatureWallMetricTensor/(aLit gammaLit^2), Delta > 0
	];
	literatureWallDampingTensor = FullSimplify[
	  literatureWallMassTensor gammaLit aLit G2Lit, Delta > 0
	];
	literatureWallGeneralizedForce = {FXLit, FPhiLit};
	singleWallCoordinates = {X[t], Phi[t]};
	singleWallVelocity = D[singleWallCoordinates, t];
	singleWallAcceleration = D[singleWallCoordinates, {t, 2}];
	singleWallSOTForceDynamic = FullSimplify[
	  singleWallSOTForce /. Phic -> Phi[t],
	  Delta > 0
	];
	literatureWallSourceResidual = FullSimplify[
	  literatureWallMassTensor . singleWallAcceleration +
	  literatureWallDampingTensor . singleWallVelocity -
	  literatureWallGeneralizedForce,
	  Delta > 0
	];
	literatureWallBridgeRules = {
	  aLit -> 1/(chi gammaLit^2),
	  G2Lit -> alpha s gammaLit,
	  FXLit -> singleWallSOTForceDynamic[[1]],
	  FPhiLit -> singleWallSOTForceDynamic[[2]]
	};
	literatureWallTransformedMass = FullSimplify[
	  literatureWallMassTensor /. literatureWallBridgeRules,
	  Delta > 0
	];
	literatureWallTransformedDamping = FullSimplify[
	  literatureWallDampingTensor /. literatureWallBridgeRules,
	  Delta > 0
	];
	literatureWallTransformedForce = FullSimplify[
	  literatureWallGeneralizedForce /. literatureWallBridgeRules,
	  Delta > 0
	];
	literatureWallTransformedResidual = FullSimplify[
	  literatureWallSourceResidual /. literatureWallBridgeRules,
	  Delta > 0
	];
	literatureWallTargetResidual = FullSimplify[
	  massMatrix . singleWallAcceleration +
	  dampingMatrix . singleWallVelocity -
	  singleWallSOTForceDynamic,
	  Delta > 0
	];
	literatureWallMassBridgeRegression = TrueQ[
	  FullSimplify[
	    literatureWallTransformedMass - massMatrix, Delta > 0
	  ] === ConstantArray[0, {2, 2}]
	];
	literatureWallDampingBridgeRegression = TrueQ[
	  FullSimplify[
	    literatureWallTransformedDamping - dampingMatrix, Delta > 0
	  ] === ConstantArray[0, {2, 2}]
	];
	literatureWallForceBridgeRegression = TrueQ[
	  FullSimplify[
	    literatureWallTransformedForce - singleWallSOTForceDynamic,
	    Delta > 0
	  ] === {0, 0}
	];
	literatureWallExactRegression = TrueQ[
	  literatureWallMassBridgeRegression &&
	  literatureWallDampingBridgeRegression &&
	  literatureWallForceBridgeRegression &&
	  FullSimplify[
	    literatureWallTransformedResidual - literatureWallTargetResidual,
	    Delta > 0
	  ] === {0, 0}
	];

	nWalls = 4;
	uStatic = {u1, u2, u3, u4};
	uDynamic = {u1[t], u2[t], u3[t], u4[t]};
	phiChain = {Phi1, Phi2, Phi3, Phi4};
	wallPolarities = {1, -1, 1, -1};
	chainSOTForce = Table[
	  FullSimplify[
	    singleWallSOTForce[[1]] /. {
	      Phic -> phiChain[[i]], wallPolarity -> wallPolarities[[i]]
	    },
	    Delta > 0
	  ],
	  {i, nWalls}
	];
	Ueff = k/2 Sum[
	  (uStatic[[Mod[i, nWalls] + 1]] - uStatic[[i]])^2,
	  {i, 1, nWalls}
	];
	wallChainStabilityMatrix = LinearStabilityMatrix[Ueff, uStatic, {}];
	expectedStabilityMatrix = k {% raw %}{
	  {2, -1, 0, -1}, {-1, 2, -1, 0},
	  {0, -1, 2, -1}, {-1, 0, -1, 2}
	}{% endraw %};
	stabilityMatrixRegression = TrueQ[
	  FullSimplify[wallChainStabilityMatrix - expectedStabilityMatrix]
	  === ConstantArray[0, {nWalls, nWalls}]
	];
	massChainMatrix = massMatrix[[1, 1]] IdentityMatrix[nWalls];
	dampingChainMatrix = dampingMatrix[[1, 1]] IdentityMatrix[nWalls];
	stripeChainEquation = Thread[
	  massChainMatrix . D[uDynamic, {t, 2}] +
	  dampingChainMatrix . D[uDynamic, t] +
	  wallChainStabilityMatrix . uDynamic == chainSOTForce
	];
	expectedChainEquation = Thread[
	  (2 chi/Delta) D[uDynamic, {t, 2}] +
	  (2 alpha s/Delta) D[uDynamic, t] +
	  expectedStabilityMatrix . uDynamic == chainSOTForce
	];
	chainEquationRegression = TrueQ[
	  FullSimplify[stripeChainEquation == expectedChainEquation, Delta > 0]
	];
	alphaLimitRegression = TrueQ[
	  FullSimplify[dampingChainMatrix /. alpha -> 0] === ConstantArray[0, {nWalls, nWalls}]
	];

	(* Executable dimensional contract for the 1D energy-per-transverse-area convention. *)
	dimensionBasis = {"energy", "length", "time"};
	dimEnergy = {1, 0, 0};
	dimLength = {0, 1, 0};
	dimTime = {0, 0, 1};
	dimless = {0, 0, 0};
	dimA = DimensionProduct[dimEnergy, dimLength];
	dimK = DimensionQuotient[dimEnergy, dimLength];
	dimDmi = dimEnergy;
	dimChi = DimensionProduct[
	  dimEnergy, DimensionPower[dimTime, 2], DimensionPower[dimLength, -1]
	];
	dimS = DimensionProduct[dimEnergy, dimTime, DimensionPower[dimLength, -1]];
	dimTau = DimensionQuotient[dimEnergy, dimLength];
	dimChainK = DimensionProduct[dimEnergy, DimensionPower[dimLength, -2]];
	energyDensityTermDimensions = <|
	  "exchange" -> DimensionProduct[dimA, DimensionPower[dimLength, -2]],
	  "anisotropy" -> dimK,
	  "dmi" -> DimensionProduct[dimDmi, DimensionPower[dimLength, -1]]
	|>;
	energyDensityDimensionRegression = TrueQ[
	  Apply[DimensionEqualQ, Values[energyDensityTermDimensions]] &&
	  First[Values[energyDensityTermDimensions]] === DimensionQuotient[dimEnergy, dimLength]
	];
	dimMassXX = DimensionQuotient[dimChi, dimLength];
	dimGammaXX = DimensionQuotient[dimS, dimLength];
	translationTermDimensions = <|
	  "inertia" -> DimensionProduct[
	    dimMassXX, dimLength, DimensionPower[dimTime, -2]
	  ],
	  "damping" -> DimensionProduct[
	    dimGammaXX, dimLength, DimensionPower[dimTime, -1]
	  ],
	  "stiffness" -> DimensionProduct[dimChainK, dimLength],
	  "sot_force" -> dimTau
	|>;
	translationDimensionRegression = TrueQ[
	  Apply[DimensionEqualQ, Values[translationTermDimensions]] &&
	  First[Values[translationTermDimensions]] === DimensionQuotient[dimEnergy, dimLength]
	];
	dimMassPhi = DimensionProduct[dimChi, dimLength];
	dimGammaPhi = DimensionProduct[dimS, dimLength];
	angleTermDimensions = <|
	  "inertia" -> DimensionProduct[dimMassPhi, DimensionPower[dimTime, -2]],
	  "damping" -> DimensionProduct[dimGammaPhi, DimensionPower[dimTime, -1]],
	  "sot_force" -> DimensionProduct[dimLength, dimTau]
	|>;
	angleDimensionRegression = TrueQ[
	  Apply[DimensionEqualQ, Values[angleTermDimensions]] &&
	  First[Values[angleTermDimensions]] === dimEnergy
	];
	dimensionContract = <|
	  "basis" -> dimensionBasis,
	  "convention" -> "one_dimensional_energy_per_transverse_area",
	  "assignments" -> <|
	    "dimensionless" -> dimless, "x_X_Delta" -> dimLength,
	    "A" -> dimA, "K" -> dimK, "D" -> dimDmi,
	    "chi" -> dimChi, "s" -> dimS, "tau" -> dimTau,
	    "k" -> dimChainK, "M_XX" -> dimMassXX, "Gamma_XX" -> dimGammaXX,
	    "M_PhiPhi" -> dimMassPhi, "Gamma_PhiPhi" -> dimGammaPhi
	  |>,
	  "energy_density_terms" -> energyDensityTermDimensions,
	  "translation_terms" -> translationTermDimensions,
	  "internal_angle_terms" -> angleTermDimensions
	|>;

	Print["Domain-wall ansatz nDW:"];
	Print[AgentRecord["domain_wall_ansatz", nDW]];
	Print["Domain-wall norm constraint regression:"];
	Print[AgentRecord["ansatz_constraint_regression", ansatzConstraintRegression]];
	Print["Collective metric integrand d_q n . d_q n:"];
	Print[AgentRecord["collective_metric_integrand", metricIntegrand]];
	Print["Collective metric integrand vanishes at both spatial infinities:"];
	Print[AgentRecord["metric_boundary_regression", metricBoundaryRegression]];
	Print["SOT projection integrand vanishes at both spatial infinities:"];
	Print[AgentRecord["sot_boundary_regression", sotBoundaryRegression]];
	Print["Integrated collective metric matrix:"];
	Print[AgentRecord["collective_metric_matrix", collectiveMetricMatrix]];
	Print["Collective metric matrix regression:"];
	Print[AgentRecord["metric_matrix_regression", metricMatrixRegression]];
	Print["Mass matrix definition:"];
	Print[AgentRecord["collective_mass_matrix_definition", massMatrixDefinition]];
	Print["Collective mass matrix:"];
	Print[AgentRecord["collective_mass_matrix", massMatrix]];
	Print["Mass matrix regression:"];
	Print[AgentRecord["mass_matrix_regression", massMatrixRegression]];
	Print["Damping matrix definition:"];
	Print[AgentRecord["collective_damping_matrix_definition", dampingMatrixDefinition]];
	Print["Collective damping matrix:"];
	Print[AgentRecord["collective_damping_matrix", dampingMatrix]];
	Print["Damping matrix regression:"];
	Print[AgentRecord["damping_matrix_regression", dampingMatrixRegression]];
	Print["Single-wall SOT generalized force {F_X, F_Phi}:"];
	Print[AgentRecord["single_wall_sot_generalized_force", singleWallSOTForce]];
	Print["SOT generalized-force regression:"];
	Print[AgentRecord["sot_force_regression", sotForceRegression]];
	Print["Equation-level AFM single-wall literature transformation:"];
	Print[AgentRecord["literature_wall_source_residual", literatureWallSourceResidual]];
	Print[AgentRecord["literature_wall_target_residual", literatureWallTargetResidual]];
	Print[AgentRecord["literature_wall_transformed_residual", literatureWallTransformedResidual]];
	Print[AgentRecord["literature_wall_mass_bridge_regression", literatureWallMassBridgeRegression]];
	Print[AgentRecord["literature_wall_damping_bridge_regression", literatureWallDampingBridgeRegression]];
	Print[AgentRecord["literature_wall_force_bridge_regression", literatureWallForceBridgeRegression]];
	Print[AgentRecord["literature_wall_exact_regression", literatureWallExactRegression]];
	Print["Alternating-polarity chain SOT force:"];
	Print[AgentRecord["chain_sot_force", chainSOTForce]];
	Print["Wall-chain linear stability matrix for four periodic walls:"];
	Print[AgentRecord["wall_chain_stability_matrix", wallChainStabilityMatrix]];
	Print["Wall-chain stability-matrix regression:"];
	Print[AgentRecord["stability_matrix_regression", stabilityMatrixRegression]];
	Print["Derived stripe-chain equations:"];
	Print[AgentRecord["stripe_chain_equation", stripeChainEquation]];
	Print["Stripe-chain equation regression:"];
	Print[AgentRecord["chain_equation_regression", chainEquationRegression]];
	Print["Zero-damping limit regression:"];
	Print[AgentRecord["alpha_limit_regression", alphaLimitRegression]];
	Print["Declared dimension contract:"];
	Print[AgentRecord["dimension_contract", dimensionContract]];
	Print["One-dimensional energy-density dimension regression:"];
	Print[AgentRecord["energy_density_dimension_regression", energyDensityDimensionRegression]];
	Print["Translation-equation dimension regression:"];
	Print[AgentRecord["translation_dimension_regression", translationDimensionRegression]];
	Print["Internal-angle-equation dimension regression:"];
	Print[AgentRecord["angle_dimension_regression", angleDimensionRegression]];
	{% elif task.texture == "skyrmion" %}
	(* AFM skyrmion inertial collective-coordinate calculation. *)
	{% if physics_ir.support_level == "full_derivation" %}
	ClearAll[
	  Xc, Yc, X, Y, R0, DeltaSk, polarity, winding, helicity, r, phi,
	  thetaProfile, uTheta, Qn, Dsk, IsotAFM, sA, sB,
	  aLit, gammaLit, G2Lit, tauLit
	];
	nSky = SkyrmionAnsatz[x, y, Xc, Yc, R0, DeltaSk, polarity, 1, helicity];
	nPolar = AxisymmetricSkyrmionField[thetaProfile[r], phi, polarity, 1, helicity];
	translationTangents = PolarTranslationTangents[nPolar, r, phi];
	projectionAssumptions = r > 0 && polarity^2 == 1 &&
	  Element[{r, helicity, polarity, px, py, tauDL, tauFL}, Reals];
	metricAngularDensity = AngularCollectiveMetricMatrix[
	  translationTangents, r, phi, projectionAssumptions
	];
	expectedMetricAngularDensity = Pi (
	  Sin[thetaProfile[r]]^2/r + r thetaProfile'[r]^2
	) IdentityMatrix[2];
	metricDensityRegression = TrueQ[
	  FullSimplify[
	    metricAngularDensity - expectedMetricAngularDensity,
	    projectionAssumptions
	  ] === ConstantArray[0, {2, 2}]
	];
	topologicalDensityRadial = RadialTopologicalDensity2D[
	  thetaProfile[r], r, 1, polarity
	];
	topologicalCharge = FullSimplify[
	  polarity/2 Integrate[Sin[uTheta], {uTheta, Pi, 0}],
	  polarity^2 == 1
	];
	topologicalChargeRegression = TrueQ[topologicalCharge === -polarity];
	Qn = topologicalCharge;
	dissipationIntegralDefinition = HoldForm[
	  Dsk == Pi Integrate[
	    r thetaProfile'[r]^2 + Sin[thetaProfile[r]]^2/r,
	    {r, 0, Infinity}
	  ]
	];
	massMatrix = IsotropicCollectiveTensor[chi Dsk];
	dampingMatrix = IsotropicCollectiveTensor[alpha s Dsk];
	massMatrixRegression = TrueQ[massMatrix === chi Dsk IdentityMatrix[2]];
	dampingMatrixRegression = TrueQ[
	  dampingMatrix === alpha s Dsk IdentityMatrix[2]
	];

	dampingLikeForceDensity = SOTDrive[nPolar, {px, py, 0}, tauDL, 0];
	fieldLikeForceDensity = SOTDrive[nPolar, {px, py, 0}, 0, tauFL];
	dampingLikeForceAngularDensity = AngularGeneralizedForceDensity[
	  translationTangents, dampingLikeForceDensity, r, phi, projectionAssumptions
	];
	fieldLikeForceAngularDensity = AngularGeneralizedForceDensity[
	  translationTangents, fieldLikeForceDensity, r, phi, projectionAssumptions
	];
	expectedDampingLikeForceAngularDensity = Pi tauDL D[
	  r Sin[thetaProfile[r]], r
	] {
	  px Cos[helicity] + py Sin[helicity],
	  py Cos[helicity] - px Sin[helicity]
	};
	expectedFieldLikeForceAngularDensity = Pi polarity tauFL (
	  Cos[thetaProfile[r]] Sin[thetaProfile[r]] + r thetaProfile'[r]
	) {
	  py Cos[helicity] - px Sin[helicity],
	  -(px Cos[helicity] + py Sin[helicity])
	};
	dampingLikeBoundaryRegression = TrueQ[
	  FullSimplify[
	    dampingLikeForceAngularDensity - expectedDampingLikeForceAngularDensity,
	    projectionAssumptions
	  ] === {0, 0}
	];
	fieldLikeForceDensityRegression = TrueQ[
