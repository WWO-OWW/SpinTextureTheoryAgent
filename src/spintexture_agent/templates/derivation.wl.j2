(* ::Package:: *)
(* Generated by SpinTextureTheoryAgent *)
(* Task: {{ task.task_name }} *)

spinTexturePackagePath = "{{ wolfram_library_path }}";
If[!FileExistsQ[spinTexturePackagePath],
  spinTexturePackagePath = FileNameJoin[
    {DirectoryName[$InputFileName], "..", "..", "mathematica", "SpinTextureTheory.wl"}
  ];
];
Get[spinTexturePackagePath];

ToAgentString[expr_String] := expr;
ToAgentString[expr_] := ToString[expr, InputForm];
agentResults = <||>;
AgentRecord[key_String, expr_] := (
  agentResults = Join[agentResults, <|key -> ToAgentString[expr]|>];
  expr
);

Print["Task: {{ task.task_name }}"];
Print["Authoritative record ID: {{ record_id }}"];
Print["Template: {{ template.name }}"];
Print["Dynamics: {{ template.dynamics }}"];
Print["Order parameters: {{ template.order_parameters }}"];
Print["Assumptions: {{ task.assumptions }}"];
{% if physics_ir %}
Print["Physics IR energy terms: {{ physics_ir.energy_terms }}"];
Print["Physics IR topology field: {{ physics_ir.order_parameter.topology_field }}"];
Print["Physics IR expected equation type: {{ physics_ir.dynamics.expected_equation_type }}"];
Print["Physics IR support level: {{ physics_ir.support_level }}"];
Print["Physics IR knowledge status: {{ physics_ir.knowledge_status }}"];
